# ─────────────────────────────────────────────────────────────────────────
# Apresentação Planejamento — configuração do servidor
# Copie para .env.local (fora do git) e preencha. O mesmo conjunto de
# variáveis vale para a futura versão PHP (config.php lê as mesmas chaves).
# ─────────────────────────────────────────────────────────────────────────

# Porta do servidor local
PORT=5210

# Origem dos dados: "graph" (SharePoint real) ou "exemplo" (dados fictícios de tests/fixtures)
DATA_SOURCE=graph

# Onde ficam usuários, cadastros e anexos:
#   supabase = produção (Supabase Auth + tabelas + Storage) — obrigatório na Vercel
#   local    = arquivos em DATA_DIR (desenvolvimento, testes, demonstração)
STORE=local

# Supabase (projeto exclusivo deste app) — Project Settings → API
# A service role é segredo do servidor: nunca em variável VITE_/front, nunca no git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=apresentacao

# Pasta de dados do modo local (na Vercel não é usada)
DATA_DIR=./data

# Minutos que as planilhas do SharePoint ficam em cache no servidor
CACHE_MINUTOS=30

# Só e-mails deste domínio entram no app (primeiro acesso e novos usuários). Vazio = qualquer domínio.
DOMINIO_EMAIL=unitaengenharia.com.br

# Segredo das sessões. Vazio: local gera em data/.segredo; Supabase deriva da service role.
# Recomendado definir na Vercel (trocar o valor encerra todas as sessões).
SESSION_SECRET=

# Microsoft Graph (app-only) — mesmo aplicativo do APP-PROJEÇÃO
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=b!S3La9JidLE6c3ZTf28lb-loVt7u-9xdEoIsaVk0BY_mFzM2JIEI7SoDCfFHuzgqQ
MS_GRAPH_ITEM_ID=01UQIHIUQQC7IHA3D5WFHKTF6TMWDHIWVI

# INCC-DI mês a mês: série 192 do SGS/Banco Central (variação % mensal)
INCC_SGS_SERIE=192
